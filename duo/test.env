# Test build: skip the launcher so the game starts by itself and the log can be read
# without a tap. Same Duo picture settings as duo.env.
DM_ASPECT=fill
DM_PRESENT_FILL=stretch
DM_DUO_ASPECT=2853:2007
DM_LAUNCHER=0
# Screenshots on demand from the Mac: append "shot Documents/shot-N.png" to Documents/ctl.txt
# (devicectl device copy to) and the host saves the next presented frame (hle_hid.c ctl_main).
DM_CTL=Documents/ctl.txt
