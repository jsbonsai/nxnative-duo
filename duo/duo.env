# Baked into the app by --env-file (scripts/build_ipa_from_nsp.py): the Duo's picture.
# The camera takes the drawable's aspect (duo/DESIGN.md); the 16:9 canvas is widened
# back over the screen by the present pass. 2853x2007 is the Duo in landscape.
DM_ASPECT=fill
DM_PRESENT_FILL=stretch
DM_DUO_ASPECT=2853:2007
